# Avoma REST API authentication
AVOMA_API_KEY=

# Claude AI (Anthropic) API authentication
ANTHROPIC_API_KEY=

# Anthropic models. Per-account extraction defaults to Haiku (cheap, structured);
# cross-account synthesis defaults to Sonnet. ANTHROPIC_MODEL sets both at once.
ANALYSIS_MODEL=claude-haiku-4-5-20251001
AGGREGATE_MODEL=claude-sonnet-4-6
# ANTHROPIC_MODEL=

# Limit number of accounts processed per sync.
# Set to 1 to test on a single account (cheap — one AI analysis); 0 = unlimited.
MAX_DEALS=1

# Server port (Railway sets this automatically; defaults to 3000 locally)
# PORT=8080
