# Avoma REST API authentication
AVOMA_API_KEY=

# Claude AI (Anthropic) API authentication
ANTHROPIC_API_KEY=

# Anthropic models. Per-account extraction defaults to Haiku (cheap, structured);
# cross-account synthesis defaults to Sonnet. ANTHROPIC_MODEL sets both at once.
ANALYSIS_MODEL=claude-haiku-4-5-20251001
AGGREGATE_MODEL=claude-sonnet-4-6
# ANTHROPIC_MODEL=

# Analyze accounts via the Anthropic Message Batches API (~50% cheaper, no
# per-call rate-limit pacing). Set to 0 to use sequential live calls instead.
BATCH_ANALYSIS=1

# Limit number of accounts processed per sync.
# Set to 1 to test on a single account (cheap — one AI analysis); 0 = unlimited.
MAX_DEALS=1

# Shared secret for the destructive / paid API routes (POST /api/reset,
# /api/sync?force=1, /api/aggregate, /api/feature-scan, /api/win-reasons,
# /api/feature-interest). Send it as the `x-duro-token` request header.
# FAILS CLOSED: if this is unset, those endpoints are denied outright.
# Generate one with:  openssl rand -hex 32
DURO_ADMIN_TOKEN=

# Passcode for the dashboard's client-side gate. Required — with this unset the
# app renders a "passcode not configured" screen instead of the dashboard.
# Must be exactly 4 digits (e.g. 8241): the gate is a numeric keypad capped at
# 4 characters, so any other value cannot be typed in and locks the dashboard.
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time, so
# changing it requires a rebuild/redeploy, and it is not secret from anyone who
# inspects the page. It guards no /api route (that's DURO_ADMIN_TOKEN).
NEXT_PUBLIC_DASHBOARD_PASSCODE=

# Meetings Avoma confirms have no transcript are remembered so they aren't
# re-polled every sync. Meetings this recent are re-checked anyway, covering
# Avoma's transcription delay. Set to 0 to bypass the cache and re-poll all.
NO_TRANSCRIPT_RECHECK_DAYS=7

# Server port (Railway sets this automatically; defaults to 3000 locally)
# PORT=8080
